{
  "info": {
    "name": "Alumbrado - RF-03 Autenticacion / RF-04 Alta y Baja de Usuarios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "tecnicoId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
  },
  "item": [
    {
      "name": "1. Registro de vecino (publico) - RF-01",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": "{{baseUrl}}/api/auth/registro",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana Vecina\",\n  \"email\": \"ana@vecino.com\",\n  \"password\": \"clave1234\",\n  \"dni\": 30111222,\n  \"celular\": \"2262-400400\",\n  \"calle\": \"San Martin\",\n  \"numeroCalle\": 123\n}"
        }
      }
    },
    {
      "name": "2. Login con DNI y contrasena - RF-03",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('devuelve token', () => pm.expect(b.token).to.be.a('string').and.not.empty);",
              "pm.test('devuelve rol', () => pm.expect(b.rol).to.be.oneOf(['VECINO','TECNICO','ADMINISTRADOR']));",
              "pm.collectionVariables.set('token', b.token);",
              "console.log('rol =', b.rol);"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": 30111222,\n  \"password\": \"clave1234\"\n}"
        }
      }
    },
    {
      "name": "3. Login con clave incorrecta -> 401 - RF-03",
      "event": [
        {
          "listen": "test",
          "script": { "exec": [ "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));" ] }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"dni\": 30111222,\n  \"password\": \"MAL\"\n}" }
      }
    },
    {
      "name": "4. GET /api/usuarios SIN token -> 401 - RF-03",
      "event": [
        {
          "listen": "test",
          "script": { "exec": [ "pm.test('401 sin token', () => pm.response.to.have.status(401));" ] }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "url": "{{baseUrl}}/api/usuarios"
      }
    },
    {
      "name": "5. GET /api/usuarios como VECINO -> 403 - RF-02/03",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('403 rol insuficiente (si el token es de VECINO)', () => pm.expect(pm.response.code).to.be.oneOf([200,403]));",
              "if (pm.response.code === 403) console.log('OK: el vecino no accede a la gestion de usuarios');"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/usuarios" }
    },
    {
      "name": "6. Listar usuarios (ADMIN) - RF-04",
      "event": [
        {
          "listen": "test",
          "script": { "exec": [ "pm.test('200 OK (token de ADMINISTRADOR)', () => pm.response.to.have.status(200));" ] }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/usuarios" }
    },
    {
      "name": "7. Alta de TECNICO con cuadrilla (ADMIN) - RF-04",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test('rol TECNICO', () => pm.expect(b.rol).to.eql('TECNICO'));",
              "pm.test('quedo asignado a la cuadrilla', () => pm.expect(b.cuadrillaId).to.eql(1));",
              "pm.collectionVariables.set('tecnicoId', b.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": "{{baseUrl}}/api/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Luis Tecnico\",\n  \"email\": \"luis@cuadrilla.com\",\n  \"password\": \"clave1234\",\n  \"dni\": 28999888,\n  \"rol\": \"TECNICO\",\n  \"cuadrillaId\": 1\n}"
        }
      }
    },
    {
      "name": "8. Editar usuario: reasignar a otra cuadrilla (ADMIN) - RF-04",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('cuadrilla reasignada a 2', () => pm.expect(b.cuadrillaId).to.eql(2));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": "{{baseUrl}}/api/usuarios/{{tecnicoId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Luis Tecnico\",\n  \"email\": \"luis@cuadrilla.com\",\n  \"dni\": 28999888,\n  \"rol\": \"TECNICO\",\n  \"cuadrillaId\": 2\n}"
        }
      }
    },
    {
      "name": "9. Baja logica de usuario (ADMIN) - RF-04",
      "event": [
        {
          "listen": "test",
          "script": { "exec": [ "pm.test('204 No Content', () => pm.response.to.have.status(204));" ] }
        }
      ],
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/usuarios/{{tecnicoId}}" }
    },
    {
      "name": "10. El usuario dado de baja ya no puede loguear -> 401 - RF-04",
      "event": [
        {
          "listen": "test",
          "script": { "exec": [ "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));" ] }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"dni\": 28999888,\n  \"password\": \"clave1234\"\n}" }
      }
    }
  ]
}
