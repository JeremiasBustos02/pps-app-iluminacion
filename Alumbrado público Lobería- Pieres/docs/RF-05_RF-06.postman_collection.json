    {
      "name": "3. RF-05 Mapa (semaforo y marca gris)",
      "item": [
        {
          "name": "Vecino: mapa -> punto nuevo VERDE, sin marca gris",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenVecino}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/luminarias/mapa"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const l = pm.response.json().find(x => x.id == pm.collectionVariables.get('luminariaAltaId'));",
                  "pm.test('el punto esta en el mapa', () => pm.expect(l).to.exist);",
                  "pm.test('color VERDE', () => pm.expect(l.color).to.eql('VERDE'));",
                  "pm.test('marcaGris = false', () => pm.expect(l.marcaGris).to.eql(false));"
                ]
              }
            }
          ]
        },
