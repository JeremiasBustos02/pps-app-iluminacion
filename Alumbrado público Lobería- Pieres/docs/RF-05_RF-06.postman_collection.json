    {
      "name": "1. Zonas (obtener ids)",
      "item": [
        {
          "name": "Listar zonas",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/zonas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const z = pm.response.json();",
                  "const urbana = z.find(x => x.areaUrbana === true);",
                  "const rural = z.find(x => x.nombre === 'Napaleufú');",
                  "pm.test('hay zona urbana y Napaleufú (area_urbana=false)', () => { pm.expect(urbana).to.exist; pm.expect(rural).to.exist; pm.expect(rural.areaUrbana).to.eql(false); });",
                  "pm.collectionVariables.set('zonaUrbanaId', urbana.id);",
                  "pm.collectionVariables.set('zonaNoUrbanaId', rural.id);"
                ]
              }
            }
          ]
        }
      ]
    },
